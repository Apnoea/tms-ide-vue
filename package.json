{
  "name": "tms-ide-vue",
  "version": "1.0.0",
  "description": "Web IDE для сборки SVG-мнемосхем SCADA (WebScada)",
  "author": "Alexey Kozyutenko",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "desktop:build": "vite build && electron-builder --win --publish never",
    "desktop:build:linux": "vite build && electron-builder --linux --publish never",
    "desktop:preview": "vite build && node scripts/run-electron.mjs",
    "desktop:smoke": "vite build && node scripts/run-electron.mjs --smoke",
    "icon:build": "node scripts/run-electron.mjs --main scripts/icon-render.cjs"
  },
  "dependencies": {
    "@joint/core": "^4.3.1",
    "@primeuix/themes": "^2.0.3",
    "@vueuse/core": "^14.4.0",
    "fflate": "^0.8.3",
    "interactjs": "^1.10.28",
    "pinia": "^4.0.2",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "knip": "^6.31.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1"
  },
  "main": "electron/main.cjs"
}
