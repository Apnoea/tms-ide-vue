{
  "id": "cell_test",
  "label": "Тест",
  "category": "Тест",
  "shapeFile": "shape.svg",
  "width": 20,
  "height": 20,
  "slots": [
    {
      "key": "onoff",
      "type": "Boolean"
    }
  ],
  "animationTemplate": [
    {
      "idSuffix": ".true",
      "type": "shape",
      "bindings": [
        {
          "tag": "{slot.onoff}",
          "when": {
            "source": "value",
            "type": "map",
            "cases": {
              "false": {
                "apply": {
                  "addClass": "animation-hidden"
                }
              }
            }
          }
        }
      ],
      "detailTags": [
        {
          "tag": "{slot.onoff}"
        }
      ]
    },
    {
      "idSuffix": ".false",
      "type": "shape",
      "bindings": [
        {
          "tag": "{slot.onoff}",
          "when": {
            "source": "value",
            "type": "map",
            "cases": {
              "true": {
                "apply": {
                  "addClass": "animation-hidden"
                }
              }
            }
          }
        }
      ],
      "detailTags": [
        {
          "tag": "{slot.onoff}"
        }
      ]
    }
  ]
}
