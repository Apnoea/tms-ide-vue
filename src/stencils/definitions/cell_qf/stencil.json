{
  "id": "cell_qf",
  "label": "Автоматический выключатель",
  "category": "Коммутация",
  "domains": ["energy"],
  "shapeFile": "shape.svg",
  "width": 20,
  "height": 40,
  "quality": true,
  "ports": [
    {
      "name": "top",
      "x": 10,
      "y": 0
    },
    {
      "name": "bottom",
      "x": 10,
      "y": 40
    }
  ],
  "slots": [
    {
      "key": "onoff",
      "type": "Boolean"
    }
  ],
  "animationTemplate": [
    {
      "idSuffix": ".true",
      "type": "shape",
      "bindings": [
        {
          "tag": "{slot.onoff}",
          "when": {
            "source": "value",
            "type": "map",
            "cases": {
              "false": {
                "apply": {
                  "addClass": "animation-hidden"
                }
              }
            }
          }
        }
      ],
      "detailTags": [
        {
          "tag": "{slot.onoff}"
        }
      ]
    },
    {
      "idSuffix": ".false",
      "type": "shape",
      "bindings": [
        {
          "tag": "{slot.onoff}",
          "when": {
            "source": "value",
            "type": "map",
            "cases": {
              "true": {
                "apply": {
                  "addClass": "animation-hidden"
                }
              }
            }
          }
        }
      ],
      "detailTags": [
        {
          "tag": "{slot.onoff}"
        }
      ]
    }
  ]
}
