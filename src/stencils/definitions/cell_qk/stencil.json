{
  "id": "cell_qk",
  "label": "Короткозамыкатель",
  "category": "Коммутация",
  "domains": ["energy"],
  "shapeFile": "shape.svg",
  "width": 20,
  "height": 40,
  "quality": true,
  "ports": [
    {
      "name": "top",
      "x": 10,
      "y": 0
    }
  ],
  "slots": [
    {
      "key": "onoff",
      "type": "Boolean"
    },
    {
      "key": "range",
      "type": "Value"
    }
  ],
  "animationTemplate": [
    {
      "idSuffix": ".true",
      "type": "shape",
      "bindings": [
        {
          "tag": "{slot.onoff}",
          "when": {
            "source": "value",
            "type": "map",
            "cases": {
              "false": {
                "apply": {
                  "addClass": "animation-hidden"
                }
              }
            }
          }
        }
      ],
      "detailTags": [
        {
          "tag": "{slot.onoff}"
        }
      ]
    },
    {
      "idSuffix": ".false",
      "type": "shape",
      "bindings": [
        {
          "tag": "{slot.onoff}",
          "when": {
            "source": "value",
            "type": "map",
            "cases": {
              "true": {
                "apply": {
                  "addClass": "animation-hidden"
                }
              }
            }
          }
        }
      ],
      "detailTags": [
        {
          "tag": "{slot.onoff}"
        }
      ]
    }
  ],
  "ranges": [
    {
      "min": 0,
      "max": 3.99,
      "color": "#10b981"
    },
    {
      "min": 4,
      "max": 6.99,
      "color": "#f59e0b"
    },
    {
      "min": 7,
      "max": 10,
      "color": "#ef4444"
    }
  ]
}
