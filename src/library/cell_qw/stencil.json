{
  "id": "cell_qw",
  "label": "Выключатель",
  "category": "Коммутация",
  "shapeFile": "shape.svg",
  "width": 20,
  "height": 20,
  "domains": ["energy"],
  "ports": [
    {
      "name": "top",
      "x": 10,
      "y": 0
    },
    {
      "name": "right",
      "x": 20,
      "y": 10
    },
    {
      "name": "bottom",
      "x": 10,
      "y": 20
    },
    {
      "name": "left",
      "x": 0,
      "y": 10
    }
  ],
  "slots": [
    {
      "key": "range",
      "type": "Value"
    },
    {
      "key": "onoff",
      "type": "Boolean"
    }
  ],
  "ranges": [
    {
      "min": 0,
      "max": 3.99,
      "color": "#10b981"
    },
    {
      "min": 4,
      "max": 6.99,
      "color": "#f59e0b"
    },
    {
      "min": 7,
      "max": 10,
      "color": "#ef4444"
    }
  ],
  "animationTemplate": [
    {
      "idSuffix": ".true",
      "type": "shape",
      "bindings": [
        {
          "tag": "{slot.onoff}",
          "when": {
            "source": "value",
            "type": "map",
            "cases": {
              "false": {
                "apply": {
                  "addClass": "animation-hidden"
                }
              }
            }
          }
        }
      ],
      "detailTags": [
        {
          "tag": "{slot.onoff}"
        }
      ]
    }
  ]
}
