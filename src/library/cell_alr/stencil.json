{
  "id": "cell_alr",
  "label": "Аварийный сигнал",
  "category": "Сигналы",
  "shapeFile": "shape.svg",
  "width": 30,
  "height": 30,
  "domains": ["energy"],
  "slots": [
    {
      "key": "onoff",
      "type": "Boolean"
    }
  ],
  "animationTemplate": [
    {
      "idSuffix": ".true",
      "type": "shape",
      "bindings": [
        {
          "tag": "{slot.onoff}",
          "when": {
            "source": "value",
            "type": "map",
            "cases": {
              "false": {
                "apply": {
                  "addClass": "animation-hidden"
                }
              }
            }
          }
        }
      ],
      "detailTags": [
        {
          "tag": "{slot.onoff}"
        }
      ]
    }
  ]
}
